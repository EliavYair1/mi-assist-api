# ── MI Assist API — Environment Variables ──
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=700

# Database (PostgreSQL — asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://mi_user:strongpassword@localhost:5432/mi_assist

# WordPress — your existing WP site
WP_SITE_URL=https://yourdomain.com
WP_API_SECRET=generate-a-random-64-char-string-here

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=your-very-long-random-secret-here
JWT_EXPIRY_MINUTES=60

# Stripe (get from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PRO_PLUS=price_...
STRIPE_PRICE_TEAM=price_...

# PayPal (developer.paypal.com)
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_PLAN_PRO=P-...
PAYPAL_PLAN_PRO_PLUS=P-...
PAYPAL_PLAN_TEAM=P-...
PAYPAL_MODE=live

# Cloudflare R2 Storage (r2.cloudflarestorage.com)
# Can also use AWS S3 — same boto3 interface
R2_ACCOUNT_ID=...
R2_ACCESS_KEY=...
R2_SECRET_KEY=...
R2_BUCKET=mi-assist-uploads
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# App
CORS_ORIGINS=["https://yourdomain.com"]
DAILY_LIMIT_FREE=5
DAILY_LIMIT_PAID=200
UPLOAD_LIMIT_PRO_PLUS=20
MAX_UPLOAD_MB=10
DEBUG=false
